FROM public.ecr.aws/docker/library/python:3.12-slim

WORKDIR /app

COPY ./requirements.txt /app/requirements.txt

RUN pip install --no-cache-dir --upgrade -r /app/requirements.txt

COPY ./api /app/api

ENV PORT=9067

# Keep idle connections open longer than the ALB's 60s idle timeout, so the ALB never reuses a closed one
CMD ["sh", "-c", "uvicorn api.app:app --host 0.0.0.0 --port ${PORT} --timeout-keep-alive 75"]
